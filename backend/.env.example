# Settings for the FastAPI backend (backend/app/core/config.py). Every name starts with SIRA_.
#
# The API reads a file called .env from the folder it is started in. The npm scripts (npm run backend, ...)
# start it from the repository root, so copy the lines you need into the root .env, or export them in your shell.
# On Render they are set in the dashboard (see render.yaml and docs/hosting.md).

# SQLite for local development (the file is created on first run). In production, a Postgres URL such as
# postgresql://user:password@host:5432/muslimo?sslmode=require; postgres:// and postgresql:// are both accepted.
SIRA_DATABASE_URL=sqlite:///./backend/data/sira_path.db

# "development" or "test" allow POST /api/subscriptions/sync (the app reporting its own purchase).
# Any other value, such as "production", refuses it and trusts only the RevenueCat webhook.
SIRA_ENVIRONMENT=development

# Browser origins allowed to call the API (comma separated). The phone apps don't need CORS.
SIRA_CORS_ORIGINS_RAW=http://localhost:8082,http://localhost:19006,http://localhost:3000

# How long a log-in lasts, in hours (720 = 30 days).
SIRA_SESSION_TTL_HOURS=720

# Sign in with Google: the OAuth client ids tokens may be issued for (comma separated). Empty turns Google off.
SIRA_GOOGLE_CLIENT_IDS_RAW=
# Sign in with Apple: the iOS bundle id.
SIRA_APPLE_CLIENT_IDS_RAW=com.islamiclearning.muslimo

# The shared secret RevenueCat sends in the Authorization header of its webhook. Empty turns the webhook off (503).
SIRA_REVENUECAT_WEBHOOK_AUTH=

# Unlocks GET /api/admin/stats and the /api/admin/newsletter routes (header X-Admin-Key). Empty turns them off (404).
SIRA_ADMIN_KEY=

# Newsletter (backend/app/api/routes/newsletter.py, backend/app/core/brevo.py). Emails go out through Brevo.
# Empty key: sign-ups are still saved, and website sign-ups wait as "pending" until a key is set.
SIRA_BREVO_API_KEY=
# The Brevo contact list confirmed subscribers are copied into (0 = don't copy).
SIRA_BREVO_LIST_ID=0
# The sender address, which must be verified in Brevo, and its display name.
SIRA_NEWSLETTER_SENDER_EMAIL=oneworldrelief.fma@gmail.com
SIRA_NEWSLETTER_SENDER_NAME=Muslimo
# The public website, used for the confirm and unsubscribe links in emails (site/newsletter.html).
SIRA_SITE_URL=https://fahadbin-alam.github.io/Muslimo

# Slows down password and code guessing (backend/app/core/rate_limit.py). Leave on outside tests.
SIRA_RATE_LIMIT_ENABLED=true

# Largest request body the API accepts, in bytes (1048576 = 1 MiB); bigger ones are refused with 413.
# A full profile sync is the largest legitimate body. 0 turns the limit off.
SIRA_MAX_REQUEST_BODY_BYTES=1048576
