SIRA_DATABASE_URL=sqlite:///./backend/data/sira_path.db
SIRA_CORS_ORIGINS_RAW=http://localhost:8082,http://localhost:19006,http://localhost:3000
SIRA_TRUSTED_SOCIAL_LOGIN=false

# Largest request body the API accepts, in bytes (1048576 = 1 MiB); bigger ones are refused with 413.
# A full profile sync is the largest legitimate body. 0 turns the limit off.
SIRA_MAX_REQUEST_BODY_BYTES=1048576
